# ---- Web app connection (required) ----

# Must match the browser app's origin exactly.
WEB_APP_ORIGIN=http://localhost:4500

# The 3 secrets below must match the web app's frontend/.env (32+ characters).
VOICE_CONTROL_API_KEY=replace-with-at-least-32-random-characters
VOICE_TOKEN_SECRET=replace-with-the-same-32-character-secret-used-by-the-web-app
VOICE_EVENT_INGEST_KEY=replace-with-at-least-32-random-characters

# Where the backend sends transcripts and session events.
VOICE_EVENT_INGEST_URL=http://localhost:4500/api/internal/voice/events

# ---- Voice agent LLM ----

# Required. An OpenRouter API key by default; for another provider, use its key
# and set VOICE_AGENT_LLM_BASE_URL below. Also used by Gemini TTS, the
# ElevenLabs fallback and the offline evaluation.
VOICE_AGENT_LLM_API_KEY=

# Optional. Defaults to OpenRouter. Any OpenAI-compatible API works; set
# VOICE_AGENT_LLM_MODEL to a model id that provider uses. Away from OpenRouter,
# the ElevenLabs fallback is unavailable (it needs OpenRouter).
# VOICE_AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional overrides. The voice agent and evaluation default to openai/gpt-6-luna.
# VOICE_AGENT_LLM_MODEL=openai/gpt-6-luna
# VOICE_EVALUATION_LLM_MODEL=openai/gpt-6-luna

# Optional. Post-call evaluation only: seconds allowed for each evaluation
# request. It makes up to 2 attempts within a fixed 45 s total. Live buyer
# replies use VOICE_AGENT_LLM_FIRST_TOKEN_SECONDS instead.
# VOICE_EVALUATION_LLM_TIMEOUT_SECONDS=20

# Optional. Live buyer replies: a request with no reply text after this many
# seconds is re-issued once, then the turn reports an error. Raise it for
# reasoning models.
# VOICE_AGENT_LLM_FIRST_TOKEN_SECONDS=5

# Optional. Model the re-issued request goes to, so an overloaded primary isn't
# asked twice. Use one from another vendor that replies without reasoning, and
# add its price to frontend/src/lib/admin/service-prices.ts. Unset retries the
# primary model.
# VOICE_AGENT_LLM_FALLBACK_MODEL=

# Optional. Longest spoken buyer reply, in tokens. Reasoning models count
# thinking too.
# VOICE_AGENT_LLM_MAX_TOKENS=400

# ---- Speech-to-text (required: a key for each listed profile) ----

# Optional. Voice input profiles, comma-separated in order of preference. Each
# later one takes over only when the one before can no longer transcribe, and
# stays unconnected until then. Every listed profile needs its own API key.
# soniox_native (default): Soniox controls turn endings.
# assemblyai_native: Universal-3.6 Pro controls turn endings (128/640 ms silence).
# VOICE_INPUT_PROFILE=soniox_native,assemblyai_native

# Required for the default soniox_native profile.
SONIOX_API_KEY=

# Optional Soniox overrides. SONIOX_REGION defaults to jp.
# SONIOX_REGION=us
# SONIOX_MODEL=stt-rt-v5

# Required when VOICE_INPUT_PROFILE lists assemblyai_native.
# ASSEMBLYAI_API_KEY=

# Optional. Voice Focus suppresses background voices and noise before
# AssemblyAI transcribes. Defaults to off. auto follows the learner's mic type: worn
# mic -> near-field, computer's built-in mic -> far-field. off, near-field or
# far-field override it and hide the mic type choice from learners.
# ASSEMBLYAI_VOICE_FOCUS=off

# Optional suppression strength from 0.0 to 1.0; AssemblyAI defaults to 0.7.
# ASSEMBLYAI_VOICE_FOCUS_THRESHOLD=0.7

# ---- Noise filter: ai-coustics (optional) ----

# Voice Focus on the learner's mic before STT, for every input profile. Removes
# background noise and other people talking nearby. AIC_LICENSE_KEY is required
# when it is enabled.
# AIC_VOICE_FOCUS_ENABLED=false
# AIC_LICENSE_KEY=
# AIC_MODEL_ID=quail-vf-2.2-l-16khz

# Strength from 0.0 to 1.0; the model defaults to 0.5. Raise toward 0.8 if
# other voices still reach the transcript.
# AIC_ENHANCEMENT_LEVEL=0.5

# ---- Text-to-speech: Soniox and Gemini (optional overrides) ----

# Soniox TTS uses SONIOX_API_KEY.
# SONIOX_TTS_MODEL=tts-rt-v2
# SONIOX_TTS_VOICE_FEMALE=Huong
# SONIOX_TTS_VOICE_MALE=Bernardo

# Gemini TTS uses VOICE_AGENT_LLM_BASE_URL and VOICE_AGENT_LLM_API_KEY.
# GEMINI_TTS_VOICE_FEMALE=Kore
# GEMINI_TTS_VOICE_MALE=Charon

# Gemini only: full_reply waits for the complete LLM reply (default);
# sentence restores per-sentence synthesis for lower startup latency.
# Change in .env and restart the backend before starting a new session.
# GEMINI_TTS_AGGREGATION_MODE=full_reply

# ---- Text-to-speech: ElevenLabs (optional) ----

# Set the key and both voice IDs to enable it; without them the backend still
# starts and ElevenLabs sessions are refused.
# Key: ElevenLabs > Developers > API Keys (Text to Speech access is enough).
# Voice IDs: ElevenLabs > Voices > My Voices > (voice) > Copy voice ID.
# The Free plan cannot use Voice Library voices through the API (the session
# fails with "voice_id ... does not exist"); use default voices or a paid plan.
# For a paid account, save your selected Library voices to My Voices before
# WebSocket use. A first HTTP generation also registered them in our check.
# ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_VOICE_FEMALE=
# ELEVENLABS_TTS_VOICE_MALE=

# V3/V4 models use the Text-to-Dialogue WebSocket; Flash/Turbo v2.5 use TTS.
# V4 Turbo supports Vietnamese and is sent language_code=vi (see README).
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# When ElevenLabs fails at call start or mid-call, the same model and voice take
# over through OpenRouter, so the buyer's voice doesn't change. Needs
# VOICE_AGENT_LLM_BASE_URL to point at OpenRouter; it bills to
# VOICE_AGENT_LLM_API_KEY. Set false to end the call instead.
# ELEVENLABS_TTS_OPENROUTER_FALLBACK=true

# ---- Sessions and network (optional) ----

# MAX_CONCURRENT_SESSIONS=20
# SESSION_MAX_SECONDS=900

# Pending connections must become ready within this deadline.
# CONNECTION_STARTUP_SECONDS=120

# A ready client sends a heartbeat every 5 seconds.
# CONNECTION_HEARTBEAT_SECONDS=30

# Keep the saved transcript resumable after loss; no voice worker runs during grace.
# CONNECTION_RECONNECT_SECONDS=60

# Learner silent this long after the buyer finishes speaking: the buyer checks in once.
# 0 turns silence handling off.
# LEARNER_IDLE_CHECK_IN_SECONDS=20

# Still silent this long after the check-in: the buyer says goodbye and ends the call.
# LEARNER_IDLE_HANG_UP_SECONDS=15

# Comma-separated ICE server URLs for WebRTC.
# WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# ---- Tracing: Langfuse (optional, off by default) ----

# Spans include LLM prompts, STT transcripts and TTS text, which are sent to Langfuse.
# Use https://us.cloud.langfuse.com for the US region.
# ENABLE_TRACING=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- App server (optional; these are the defaults) ----

# development | production | test
APP_ENV=development

# docker-compose.yml overrides APP_PORT and APP_HOST to bind 127.0.0.1:8000.
APP_PORT=8000
APP_HOST=0.0.0.0

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:4500,http://localhost:3000


# ---- Offline buyer evaluation: eval/buyer (optional) ----

# Each defaults to its VOICE_AGENT_LLM_* counterpart. A judge on a different
# host needs its own model and key; the voice agent's are not reused there.
# EVAL_JUDGE_LLM_MODEL=
# EVAL_JUDGE_LLM_BASE_URL=https://openrouter.ai/api/v1
# EVAL_JUDGE_LLM_API_KEY=

