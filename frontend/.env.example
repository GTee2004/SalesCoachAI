# ---- Database (required): use option A or option B ----

# Option A: an external PostgreSQL server (Neon, managed or self-hosted)
DATABASE_URL="postgresql://xyz"

# Option B: PostgreSQL in Docker (docker compose --profile db up -d).
# Comment out option A, then uncomment both lines below and use the same
# password in each. Generate one with: openssl rand -hex 32
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/postgres

# ---- Auth (required) ----

# Public origin of the web app
BETTER_AUTH_URL=http://localhost:4500

# Generate with: openssl rand -hex 16
# or: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=

# ---- Email (SMTP) ----

# Required
SMTP_USER=
SMTP_PASSWORD=

# Optional; defaults to eagle.mxlogin.com and port 465
SMTP_HOST=
SMTP_PORT=

# ---- Voice backend (required) ----

# Backend URL for server-to-server calls (internal) and for the browser (public)
VOICE_BACKEND_INTERNAL_URL=http://localhost:8000
VOICE_BACKEND_PUBLIC_URL=http://localhost:8000

# 3 giá trị dưới cần khớp với backend env (32+ ký tự)
VOICE_CONTROL_API_KEY=
VOICE_TOKEN_SECRET=
VOICE_EVENT_INGEST_KEY=

# ---- Service alerts (optional) ----

# Email cảnh báo cho admin khi database hoặc dịch vụ giọng nói ngừng: on | off.
# Bỏ trống: bật khi NODE_ENV=production, tắt khi chạy dev.
SERVICE_ALERT_EMAILS=

# ---- Billing: SePay (optional; checkout stays disabled until credentials are set) ----

# sandbox | production
SEPAY_ENV=sandbox

# Public HTTPS app origin used for SePay return URLs; defaults to BETTER_AUTH_URL.
BILLING_PUBLIC_BASE_URL=

SEPAY_MERCHANT_ID=

# Merchant key from SePay Sandbox integration credentials; signs checkout forms.
SEPAY_SECRET_KEY=

# Required once billing is used, in sandbox and production; matches SePay SECRET_KEY IPN auth.
SEPAY_IPN_SECRET=

# ---- Billing sweep (optional) ----

# Server-only bearer secret for the scheduled billing sweep (32+ chars).
# Generate with: openssl rand -hex 32
# With Docker, the billing-sweep service (--profile billing) reads it from this
# file; with another scheduler, configure the same value there.
BILLING_SWEEP_SECRET=

# ---- Langfuse (optional) ----

# "Xem trace trong Langfuse" link in the admin transcript. Same host as the
# voice backend's LANGFUSE_BASE_URL; the project id is in the Langfuse URL.
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=

# ---- Demo login (optional) ----

# Show the demo account (demo@demo.com / demo1234) on the login page: on | off.
# The account itself must exist in the database. Defaults to off.
DEMO_LOGIN=
